{
  "id": "/",
  "name": "محاسبي",
  "short_name": "محاسبي",
  "description": "حسابات محلات الموبايلات والإكسسوارات والصيانة: الكاشير والمخزن والصيانة والوردية، شغال حتى لو النت فصل.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#FFFFFF",
  "background_color": "#F5F7FA",
  "categories": ["business", "finance", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "/icons/icon-192.png?v=2", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png?v=2", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png?v=2", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg?v=2", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "بيع جديد",
      "short_name": "بيع",
      "description": "افتح الكاشير",
      "url": "/pos?source=shortcut",
      "icons": [{ "src": "/icons/shortcut-pos.png?v=2", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "استلام جهاز",
      "short_name": "استلام جهاز",
      "description": "تذكرة صيانة جديدة",
      "url": "/repairs/quick?source=shortcut",
      "icons": [{ "src": "/icons/shortcut-repair.png?v=2", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "استعلام سعر",
      "short_name": "سعر",
      "description": "امسح أو دوّر: السعر والمخزون",
      "url": "/?action=price-check&source=shortcut",
      "icons": [{ "src": "/icons/shortcut-price.png?v=2", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "الوردية",
      "short_name": "الوردية",
      "description": "الدرج وقفل اليوم",
      "url": "/cash?source=shortcut",
      "icons": [{ "src": "/icons/shortcut-shift.png?v=2", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "screenshots": [
    { "src": "/screenshots/narrow-home.png?v=2", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "الرئيسية: مبيعات ومكسب النهارده" },
    { "src": "/screenshots/narrow-pos.png?v=2", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "الكاشير: امسح الباركود وبيع" },
    { "src": "/screenshots/wide-home.png?v=2", "sizes": "1440x900", "type": "image/png", "form_factor": "wide", "label": "الرئيسية على الكمبيوتر" },
    { "src": "/screenshots/wide-pos.png?v=2", "sizes": "1440x900", "type": "image/png", "form_factor": "wide", "label": "الكاشير على الكمبيوتر" }
  ]
}
