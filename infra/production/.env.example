# Copy to .env (./init.sh does it and fills the secrets for you).

# --- Server ---
DOMAIN=app.example.com
# The admin panel's own domain (point its DNS here too). Empty = no admin panel.
ADMIN_DOMAIN=
# Optional: only these IPs / ranges may reach the admin panel (comma separated).
ADMIN_ALLOWED_IPS=
# The public website (landing page, prices, guide) on the root domain + www. setup-landing.sh fills both.
LANDING_DOMAIN=
LANDING_SITE_ADDRESS=
# Google Search Console / Bing Webmaster verification (the content="…" of their HTML tag); rebuild after setting.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
ACME_EMAIL=you@example.com

# --- Laravel ---
APP_NAME=Muhasebi
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=muhasebi
DB_USERNAME=muhasebi
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=app.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MAIL_MAILER=log

# Subscriptions: where shops send InstaPay payments (shown on the billing page)
BILLING_INSTAPAY_ADDRESS=
BILLING_INSTAPAY_NAME=
BILLING_INSTAPAY_PHONE=

# Push notifications (owner alerts, partner shops…). Make a pair once:
#   docker compose run --rm api php artisan notifications:vapid-keys
# Changing them later turns notifications off on every device (users turn them on again).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@muhasebi.com

# --- Backups (the `backup` service; docs/DEPLOY.md) ---
# Every day at BACKUP_TIME (in BACKUP_TZ) into infra/production/backups/, keeping BACKUP_KEEP_DAYS days.
BACKUP_TIME=03:00
BACKUP_TZ=Africa/Cairo
BACKUP_KEEP_DAYS=14
# Each backup also archives the stored files (used-device photos, payment proofs…). 0 = database only.
BACKUP_FILES=1
# Off-site copy (recommended): an rclone remote + folder, e.g. offsite:muhasebi-backups. Empty = local only.
BACKUP_RCLONE_REMOTE=
# How long off-site copies are kept (days, 0 = never delete). Default: BACKUP_KEEP_DAYS.
# BACKUP_REMOTE_KEEP_DAYS=30
# The remote itself, as rclone env config (RCLONE_CONFIG_<NAME>_<OPTION>). Cloudflare R2 example:
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true
