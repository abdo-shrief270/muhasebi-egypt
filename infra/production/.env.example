# Copy to .env (./init.sh does it and fills the secrets for you).

# --- Server ---
DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# --- Laravel ---
APP_NAME=Muhasebi
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=muhasebi
DB_USERNAME=muhasebi
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=app.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MAIL_MAILER=log
