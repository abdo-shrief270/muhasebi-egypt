{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Laravel API
	@api path /api/* /up /broadcasting/*
	handle @api {
		reverse_proxy api:80
	}

	# Reverb websockets (Laravel Echo connects to wss://<domain>/app/...)
	handle /app/* {
		reverse_proxy reverb:8080
	}

	# Nuxt build assets never change once built (hashed names).
	@assets path /_nuxt/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The SPA: unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
