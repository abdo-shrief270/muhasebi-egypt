{
	email {$ACME_EMAIL}
	servers {
		# Behind a host nginx (compose.nginx.yml) this is private_ranges, so the
		# X-Forwarded-Proto: https that nginx sets reaches Laravel unchanged.
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

# The domain (Caddy gets the HTTPS certificate itself), or ":80" behind nginx.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The admin API is only served on the admin domain (below). A handle, so it wins before @api.
	@adminapi path /api/v1/admin /api/v1/admin/*
	handle @adminapi {
		respond 404
	}

	# Laravel API
	@api path /api/* /up /broadcasting/*
	handle @api {
		reverse_proxy api:80
	}

	# Reverb websockets (Laravel Echo connects to wss://<domain>/app/...)
	handle /app/* {
		reverse_proxy reverb:8080
	}

	# Nuxt build assets never change once built (hashed names).
	# (Not the build manifest under /_nuxt/builds/, which names the latest build.)
	@assets {
		path /_nuxt/*
		not path /_nuxt/builds/*
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The service worker (offline POS) and the manifest are checked on every visit so a deploy is picked up.
	@fresh path /sw.js /_nuxt/builds/*
	header @fresh Cache-Control "no-cache"

	# The SPA: unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# The public website (LANDING_DOMAIN, e.g. muhasebi.com + www): static pages, plus the plans API
# for the pricing page. Without one it answers nowhere.
{$LANDING_SITE_ADDRESS:http://landing.invalid} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# www.<domain> → <domain>
	@www host www.{$LANDING_DOMAIN:landing.invalid}
	redir @www {scheme}://{$LANDING_DOMAIN:landing.invalid}{uri} permanent

	# Only the public plans endpoint of the API.
	handle /api/v1/public/plans {
		reverse_proxy api:80
	}
	@otherapi path /api/* /broadcasting/* /app/* /up
	handle @otherapi {
		respond 404
	}

	@assets {
		path /_nuxt/*
		not path /_nuxt/builds/*
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv-site
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /srv-site
			rewrite * /404.html
			file_server
		}
	}
}

# The platform admin panel, on its own domain (ADMIN_DOMAIN). Without one it answers nowhere.
{$ADMIN_SITE_ADDRESS:http://admin.invalid} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	# Content-Security-Policy with the hashes of this build's inline scripts (written at image build).
	import /etc/caddy/admin-csp.caddy

	# Only the admin part of the API.
	@adminapi path /api/v1/admin /api/v1/admin/*
	handle @adminapi {
		reverse_proxy api:80
	}
	@otherapi path /api/* /broadcasting/* /app/* /up
	handle @otherapi {
		respond 404
	}

	@assets path /_nuxt/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv-admin
		try_files {path} /index.html
		file_server
	}
}
