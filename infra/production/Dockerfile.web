# Nuxt SPA built to static files, served by Caddy together with the reverse proxy.
# Build context: repository root.

FROM node:22-alpine AS build
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY apps/web/ ./
# Same-origin API: the browser calls https://<domain>/api/v1.
ENV NUXT_PUBLIC_API_BASE=/api/v1
# The release (git sha from deploy.sh), sent with feedback and error reports.
ARG APP_VERSION=""
ENV NUXT_PUBLIC_APP_VERSION=$APP_VERSION
# The website's address and measurement, for the sign-up / sign-in pages only (utils/marketingTags.ts).
ARG SITE_URL=https://muhasebi.com
ARG GA_ID=
ARG META_PIXEL_ID=
ENV NUXT_PUBLIC_SITE_URL=$SITE_URL NUXT_PUBLIC_GA_ID=$GA_ID NUXT_PUBLIC_META_PIXEL_ID=$META_PIXEL_ID
RUN npx nuxi prepare && npx nuxi generate

# The admin panel: a separate app, served on the admin domain only.
FROM node:22-alpine AS admin
WORKDIR /app
COPY apps/admin/package.json apps/admin/package-lock.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY apps/admin/ ./
ENV NUXT_PUBLIC_API_BASE=/api/v1
RUN npx nuxi prepare && npx nuxi generate && node scripts/csp.mjs > .output/admin-csp.caddy

# The public website (landing page, pricing, guide), prerendered to static HTML.
FROM node:22-alpine AS site
WORKDIR /app
COPY apps/site/package.json apps/site/package-lock.json ./
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY apps/site/ ./
ARG SITE_URL=https://muhasebi.com
ARG APP_URL=https://app.muhasebi.com
# Search Console / Bing Webmaster "HTML tag" codes (only the content="…" value); empty = no tag.
ARG GOOGLE_SITE_VERIFICATION=
ARG BING_SITE_VERIFICATION=
ARG FACEBOOK_DOMAIN_VERIFICATION=
# Measurement (GA4 "G-…", Meta Pixel id) and contact / social links; empty = not shown / not loaded.
ARG GA_ID=
ARG META_PIXEL_ID=
ARG CONTACT_WHATSAPP=
ARG FACEBOOK_URL=
ARG INSTAGRAM_URL=
ARG TIKTOK_URL=
ARG YOUTUBE_URL=
# A campaign bar on every page: its text, an optional coupon code, its last day (YYYY-MM-DD).
ARG OFFER_TEXT=
ARG OFFER_CODE=
ARG OFFER_UNTIL=
ENV NUXT_PUBLIC_SITE_URL=$SITE_URL NUXT_PUBLIC_APP_URL=$APP_URL NUXT_PUBLIC_API_BASE=/api/v1 \
    NUXT_PUBLIC_GOOGLE_VERIFICATION=$GOOGLE_SITE_VERIFICATION NUXT_PUBLIC_BING_VERIFICATION=$BING_SITE_VERIFICATION \
    NUXT_PUBLIC_FACEBOOK_VERIFICATION=$FACEBOOK_DOMAIN_VERIFICATION \
    NUXT_PUBLIC_GA_ID=$GA_ID NUXT_PUBLIC_META_PIXEL_ID=$META_PIXEL_ID NUXT_PUBLIC_WHATSAPP=$CONTACT_WHATSAPP \
    NUXT_PUBLIC_FACEBOOK_URL=$FACEBOOK_URL NUXT_PUBLIC_INSTAGRAM_URL=$INSTAGRAM_URL NUXT_PUBLIC_TIKTOK_URL=$TIKTOK_URL NUXT_PUBLIC_YOUTUBE_URL=$YOUTUBE_URL \
    NUXT_PUBLIC_OFFER_TEXT=$OFFER_TEXT NUXT_PUBLIC_OFFER_CODE=$OFFER_CODE NUXT_PUBLIC_OFFER_UNTIL=$OFFER_UNTIL
RUN npx nuxi prepare && npx nuxi generate

FROM caddy:2-alpine
COPY infra/production/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/.output/public /srv
COPY --from=admin /app/.output/public /srv-admin
COPY --from=admin /app/.output/admin-csp.caddy /etc/caddy/admin-csp.caddy
COPY --from=site /app/.output/public /srv-site
